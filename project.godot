; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

; config/name kayıt klasörünü belirler (user://), oyuncu kayıtları kaybolmasın diye eski ad kalıyor;
; pencere başlığı Game._ready içinde "Gök Cephesi" yapılır.
config/name="Hangar Savaşları (Prototip)"
config/description="Gök Cephesi: parça parça savaş uçağı tasarla, uç ve cepheyi geri al."
run/main_scene="res://menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Game="*res://core/game.gd"
FloatingOrigin="*res://core/floating_origin.gd"
Planet="*res://core/planet.gd"
Weather="*res://core/weather.gd"
Crew="*res://core/crew.gd"
Career="*res://core/career.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/world_boundary_shape_size=20000.0
3d/default_gravity=9.81
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
